# Variables públicas del frontend. No incluyas secretos ni credenciales AWS.
# Déjala vacía para conservar el adaptador simulado; usa esta URL con el stack local.
VITE_API_BASE_URL=http://localhost:8787
# Configuración pública de Cognito para organizadores. Deja ambos valores vacíos
# si no vas a usar el área administrativa: el login fallará de forma explícita.
VITE_COGNITO_USER_POOL_ID=
VITE_COGNITO_CLIENT_ID=
VITE_COGNITO_REGION=eu-west-1
