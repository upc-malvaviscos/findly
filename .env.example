# Variables públicas del frontend. No incluyas secretos ni credenciales AWS.
# Valores permitidos: mock (sólo desarrollo), floci y aws.
VITE_FINDLY_EXECUTION_MODE=aws
# Déjala vacía para conservar el adaptador simulado. Usa el API local o el
# endpoint HTTPS de API Gateway del entorno gestionado; nunca incluyas secretos.
VITE_API_BASE_URL=http://localhost:8787
# Configuración pública de Cognito para organizadores. Deja ambos valores vacíos
# si no vas a usar el área administrativa: el login fallará de forma explícita.
VITE_COGNITO_USER_POOL_ID=
VITE_COGNITO_CLIENT_ID=
VITE_COGNITO_REGION=eu-west-1
