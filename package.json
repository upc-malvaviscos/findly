{
  "name": "findly",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0 <25",
    "npm": ">=11"
  },
  "scripts": {
    "dev": "vite",
    "dev:mocks": "VITE_FINDLY_EXECUTION_MODE=mock npm run dev",
    "dev:floci": "node scripts/dev-floci.mjs",
    "dev:aws": "node scripts/aws-sandbox.mjs",
    "dev:aws-destroy": "node scripts/aws-sandbox.mjs destroy",
    "dev:api": "tsx src/local/galleryServer.ts",
    "local:seed": "node scripts/local-seed-gallery.mjs",
    "lint": "npm run lint:code && npm run lint:format && npm run lint:markdown && npm run lint:terraform && npm run lint:workflows",
    "lint:code": "eslint .",
    "lint:format": "prettier --check .prettierrc.json commitlint.config.mjs eslint.config.js index.html package.json playwright.config.ts tsconfig.json tsconfig.lambda.json tsconfig.web.json vite.config.ts vitest.config.ts src tests e2e scripts infra .github/PULL_REQUEST_TEMPLATE.md .github/workflows/ci.yml .github/workflows/enable-automerge.yml",
    "lint:markdown": "markdownlint-cli2 \"**/*.md\" \"#node_modules\"",
    "lint:terraform": "for d in bootstrap environments/sandbox environments/demo environments/production ephemeral; do tflint --chdir=infra/$d || exit 1; done",
    "lint:workflows": "github-actionlint .github/workflows/*.yml",
    "typecheck": "tsc --noEmit -p tsconfig.web.json && tsc --noEmit -p tsconfig.lambda.json",
    "test": "vitest run --coverage",
    "test:unit": "npm run test",
    "test:e2e": "playwright test",
    "test:e2e:local": "playwright test --config=playwright.local.config.ts",
    "test:floci": "npm exec -- playwright test --config=playwright.local.config.ts",
    "test:aws": "node scripts/test-aws-sandbox.mjs",
    "build": "npm run build:web && npm run build:lambdas && npm run package:lambdas && npm run verify:lambdas",
    "build:web": "vite build",
    "build:lambdas": "esbuild src/lambdas/*.ts --bundle --platform=node --target=node24 --format=cjs --outdir=artifacts/lambdas",
    "package:lambdas": "node scripts/package-lambda-artifacts.mjs",
    "verify:lambdas": "node scripts/verify-lambda-artifacts.mjs",
    "terraform:format": "terraform -chdir=infra fmt -check -recursive",
    "terraform:validate": "node scripts/terraform-validate.mjs",
    "security": "npm run security:tracked-files && npm audit --omit=dev",
    "security:tracked-files": "node scripts/check-tracked-secrets.mjs",
    "sync:check": "node scripts/check-documentation-sync.mjs",
    "harness:check": "node scripts/check-local-validation-environment.mjs",
    "harness:check:e2e": "node scripts/check-local-validation-environment.mjs --e2e",
    "verify": "npm run lint && npm run typecheck && npm run test && npm run build && npm run terraform:format && npm run terraform:validate && npm run security && npm run sync:check",
    "prepare": "husky"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.1131.0",
    "@aws-sdk/client-rekognition": "^3.1126.0",
    "@aws-sdk/client-s3": "^3.1126.0",
    "@aws-sdk/lib-dynamodb": "^3.1126.0",
    "@aws-sdk/s3-request-presigner": "^3.1131.0",
    "@vitejs/plugin-react": "5.1.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "vite": "7.3.6",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.2",
    "@commitlint/config-conventional": "21.2.2",
    "@eslint/js": "9.39.5",
    "@playwright/test": "1.63.0",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "26.5.1",
    "@types/react": "19.2.8",
    "@types/react-dom": "19.2.3",
    "@vitest/coverage-v8": "4.0.18",
    "aws-sdk-client-mock": "4.1.0",
    "esbuild": "0.27.3",
    "eslint": "9.39.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.6",
    "github-actionlint": "1.7.12",
    "globals": "17.4.0",
    "husky": "9.1.7",
    "jsdom": "30.0.1",
    "markdownlint-cli2": "0.23.2",
    "prettier": "3.9.6",
    "tsx": "^4.23.13",
    "typescript": "5.9.3",
    "typescript-eslint": "8.69.0",
    "vitest": "4.0.18"
  }
}
