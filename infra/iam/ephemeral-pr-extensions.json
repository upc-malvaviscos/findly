{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "EphemeralQueues",
      "Effect": "Allow",
      "Action": [
        "sqs:CreateQueue",
        "sqs:GetQueueAttributes",
        "sqs:SetQueueAttributes",
        "sqs:DeleteQueue",
        "sqs:TagQueue",
        "sqs:UntagQueue",
        "sqs:ListQueueTags",
        "sqs:GetQueueUrl"
      ],
      "Resource": "arn:aws:sqs:eu-west-1:567158658992:findly-pr-*-*"
    },
    {
      "Sid": "EphemeralAlertsTopic",
      "Effect": "Allow",
      "Action": [
        "sns:CreateTopic",
        "sns:GetTopicAttributes",
        "sns:SetTopicAttributes",
        "sns:DeleteTopic",
        "sns:TagResource",
        "sns:UntagResource",
        "sns:ListTagsForResource",
        "sns:Subscribe"
      ],
      "Resource": "arn:aws:sns:eu-west-1:567158658992:findly-pr-*-alerts"
    },
    {
      "Sid": "EphemeralPublicMetricFilters",
      "Effect": "Allow",
      "Action": [
        "logs:PutMetricFilter",
        "logs:DescribeMetricFilters",
        "logs:DeleteMetricFilter"
      ],
      "Resource": [
        "arn:aws:logs:eu-west-1:567158658992:log-group:/aws/lambda/findly-pr-*-public-*"
      ]
    },
    {
      "Sid": "EphemeralRetentionSchedule",
      "Effect": "Allow",
      "Action": [
        "scheduler:CreateSchedule",
        "scheduler:GetSchedule",
        "scheduler:UpdateSchedule",
        "scheduler:DeleteSchedule"
      ],
      "Resource": "arn:aws:scheduler:eu-west-1:567158658992:schedule/default/findly-pr-*-retention-purger"
    },
    {
      "Sid": "EphemeralSelfieRetryConfiguration",
      "Effect": "Allow",
      "Action": [
        "lambda:PutFunctionEventInvokeConfig",
        "lambda:GetFunctionEventInvokeConfig",
        "lambda:DeleteFunctionEventInvokeConfig"
      ],
      "Resource": "arn:aws:lambda:eu-west-1:567158658992:function:findly-pr-*-selfie-indexer"
    },
    {
      "Sid": "EphemeralSchedulerExecutionRole",
      "Effect": "Allow",
      "Action": ["iam:PassRole"],
      "Resource": "arn:aws:iam::567158658992:role/findly-pr-*-retention-purger-scheduler-role",
      "Condition": {
        "StringEquals": {
          "iam:PassedToService": "scheduler.amazonaws.com"
        }
      }
    },
    {
      "Sid": "EphemeralAlertSubscriptionLifecycle",
      "Effect": "Allow",
      "Action": [
        "sns:GetSubscriptionAttributes",
        "sns:SetSubscriptionAttributes",
        "sns:Unsubscribe"
      ],
      "Resource": "arn:aws:sns:eu-west-1:567158658992:findly-pr-*-alerts"
    },
    {
      "Sid": "EphemeralDlqAlarm",
      "Effect": "Allow",
      "Action": [
        "cloudwatch:PutMetricAlarm",
        "cloudwatch:DescribeAlarms",
        "cloudwatch:DeleteAlarms",
        "cloudwatch:TagResource",
        "cloudwatch:UntagResource",
        "cloudwatch:ListTagsForResource"
      ],
      "Resource": "arn:aws:cloudwatch:eu-west-1:567158658992:alarm:findly-pr-*-photos-dlq-has-messages"
    },
    {
      "Sid": "EphemeralBucketNotifications",
      "Effect": "Allow",
      "Action": ["s3:PutBucketNotification"],
      "Resource": "arn:aws:s3:::findly-pr-*-567158658992-eu-west-1"
    },
    {
      "Sid": "EphemeralCreatePhotoQueueMapping",
      "Effect": "Allow",
      "Action": ["lambda:CreateEventSourceMapping"],
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "eu-west-1",
          "aws:RequestTag/Project": "findly",
          "aws:RequestTag/Ephemeral": "true"
        },
        "ArnLike": {
          "lambda:FunctionArn": "arn:aws:lambda:eu-west-1:567158658992:function:findly-pr-*-photo-matcher"
        },
        "StringLike": {
          "aws:RequestTag/Environment": "pr-?*",
          "aws:RequestTag/PullRequest": "?*"
        }
      }
    },
    {
      "Sid": "EphemeralPhotoQueueMappingLifecycle",
      "Effect": "Allow",
      "Action": [
        "lambda:GetEventSourceMapping",
        "lambda:UpdateEventSourceMapping",
        "lambda:DeleteEventSourceMapping"
      ],
      "Resource": "arn:aws:lambda:eu-west-1:567158658992:event-source-mapping:*",
      "Condition": {
        "ArnLike": {
          "lambda:FunctionArn": "arn:aws:lambda:eu-west-1:567158658992:function:findly-pr-*-photo-matcher"
        }
      }
    },
    {
      "Sid": "EphemeralPhotoQueueMappingTags",
      "Effect": "Allow",
      "Action": [
        "lambda:ListTags",
        "lambda:TagResource",
        "lambda:UntagResource"
      ],
      "Resource": "arn:aws:lambda:eu-west-1:567158658992:event-source-mapping:*",
      "Condition": {
        "StringEquals": {
          "aws:ResourceTag/Project": "findly",
          "aws:ResourceTag/Ephemeral": "true"
        },
        "StringLike": {
          "aws:ResourceTag/Environment": "pr-?*",
          "aws:ResourceTag/PullRequest": "?*"
        }
      }
    },
    {
      "Sid": "EphemeralSyntheticDataAssertions",
      "Effect": "Allow",
      "Action": ["dynamodb:GetItem", "dynamodb:DeleteItem", "dynamodb:Query"],
      "Resource": ["arn:aws:dynamodb:eu-west-1:567158658992:table/findly-pr-*"]
    },
    {
      "Sid": "EphemeralInvokeRetentionAcceptance",
      "Effect": "Allow",
      "Action": ["lambda:InvokeFunction"],
      "Resource": "arn:aws:lambda:eu-west-1:567158658992:function:findly-pr-*-retention-purger"
    },
    {
      "Sid": "EphemeralSyntheticSelfieFixtures",
      "Effect": "Allow",
      "Action": ["s3:PutObject"],
      "Resource": "arn:aws:s3:::findly-pr-*-567158658992-eu-west-1/events/*/selfies/*"
    },
    {
      "Sid": "EphemeralFaceAssertionAndCleanup",
      "Effect": "Allow",
      "Action": [
        "rekognition:ListFaces",
        "rekognition:DeleteCollection",
        "rekognition:DescribeCollection",
        "rekognition:TagResource"
      ],
      "Resource": "arn:aws:rekognition:eu-west-1:567158658992:collection/findly-pr-*-event-*"
    },
    {
      "Sid": "EphemeralPoisonQueueMessage",
      "Effect": "Allow",
      "Action": ["sqs:SendMessage"],
      "Resource": "arn:aws:sqs:eu-west-1:567158658992:findly-pr-*-photos-queue"
    },
    {
      "Sid": "EphemeralDlqAndAlarmAssertions",
      "Effect": "Allow",
      "Action": [
        "sqs:ReceiveMessage",
        "sqs:DeleteMessage",
        "sqs:ChangeMessageVisibility"
      ],
      "Resource": [
        "arn:aws:sqs:eu-west-1:567158658992:findly-pr-*-photos-dlq",
        "arn:aws:sqs:eu-west-1:567158658992:findly-pr-*-alert-probe"
      ]
    },
    {
      "Sid": "EphemeralApplicationLogAssertions",
      "Effect": "Allow",
      "Action": ["logs:FilterLogEvents"],
      "Resource": [
        "arn:aws:logs:eu-west-1:567158658992:log-group:/aws/lambda/findly-pr-*-*"
      ]
    },
    {
      "Sid": "ReadDeletedMappingForTerraformWaiter",
      "Effect": "Allow",
      "Action": "lambda:GetEventSourceMapping",
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "eu-west-1"
        }
      }
    },
    {
      "Sid": "EphemeralCreateTaggedSyntheticCollection",
      "Effect": "Allow",
      "Action": "rekognition:CreateCollection",
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "eu-west-1",
          "aws:RequestTag/Project": "findly",
          "aws:RequestTag/Ephemeral": "true",
          "aws:RequestTag/ManagedBy": "CI",
          "aws:RequestTag/CostCenter": "findly-ci",
          "aws:RequestTag/DataClass": "synthetic"
        },
        "StringLike": {
          "aws:RequestTag/Environment": "pr-?*",
          "aws:RequestTag/PullRequest": "?*"
        }
      }
    }
  ]
}
