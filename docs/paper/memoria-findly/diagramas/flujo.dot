digraph recorrido {
  graph [rankdir=TB, bgcolor="white", pad=0.25, nodesep=0.42, ranksep=0.62,
         fontname="Helvetica", fontsize=19, labelloc=t,
         label="Findly · recorrido funcional"];
  node [shape=box, style="rounded,filled", fontname="Helvetica", fontsize=13,
        margin="0.18,0.12", color="#31547d", fillcolor="#edf4fb", penwidth=1.4];
  edge [color="#31547d", penwidth=1.5, arrowsize=0.8, fontname="Helvetica", fontsize=10];

  participant [label="Asistente\nconsiente y se inscribe"];
  selfie [label="Selfie\nsubida directa a S3"];
  enrolled [label="ENROLLED\nidentidad facial indexada"];
  organizer [label="Organizador\nautenticado carga fotos"];
  photos [label="Fotos del evento\nsubida directa a S3"];
  gallery [label="Galería privada\ncoincidencias y enlace temporal"];
  erase [label="Retirada / caducidad\nborrado de datos asociados", fillcolor="#fff4e7", color="#b36b00"];

  participant -> selfie -> enrolled;
  organizer -> photos;
  enrolled -> gallery [label="backfill de fotos previas"];
  photos -> gallery [label="matching al llegar cada foto"];
  gallery -> erase [style=dashed, color="#b36b00", label="retención o solicitud"];
}
