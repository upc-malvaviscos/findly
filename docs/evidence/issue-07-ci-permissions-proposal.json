{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "Pr72Queues",
      "Effect": "Allow",
      "Action": [
        "sqs:CreateQueue",
        "sqs:GetQueueAttributes",
        "sqs:SetQueueAttributes",
        "sqs:DeleteQueue",
        "sqs:TagQueue",
        "sqs:UntagQueue",
        "sqs:ListQueueTags",
        "sqs:GetQueueUrl"
      ],
      "Resource": "arn:aws:sqs:eu-west-1:567158658992:findly-pr-72-*"
    },
    {
      "Sid": "Pr72AlertsTopic",
      "Effect": "Allow",
      "Action": [
        "sns:CreateTopic",
        "sns:GetTopicAttributes",
        "sns:SetTopicAttributes",
        "sns:DeleteTopic",
        "sns:TagResource",
        "sns:UntagResource",
        "sns:ListTagsForResource",
        "sns:Subscribe"
      ],
      "Resource": "arn:aws:sns:eu-west-1:567158658992:findly-pr-72-alerts"
    },
    {
      "Sid": "Pr72PublicMetricFilters",
      "Effect": "Allow",
      "Action": [
        "logs:PutMetricFilter",
        "logs:DescribeMetricFilters",
        "logs:DeleteMetricFilter"
      ],
      "Resource": [
        "arn:aws:logs:eu-west-1:567158658992:log-group:/aws/lambda/findly-pr-72-public-*",
        "arn:aws:logs:eu-west-1:567158658992:log-group:/aws/lambda/findly-pr-72-public-*:*"
      ]
    },
    {
      "Sid": "Pr72RetentionSchedule",
      "Effect": "Allow",
      "Action": [
        "scheduler:CreateSchedule",
        "scheduler:GetSchedule",
        "scheduler:UpdateSchedule",
        "scheduler:DeleteSchedule"
      ],
      "Resource": "arn:aws:scheduler:eu-west-1:567158658992:schedule/default/findly-pr-72-retention-purger"
    },
    {
      "Sid": "Pr72SelfieRetryConfiguration",
      "Effect": "Allow",
      "Action": [
        "lambda:PutFunctionEventInvokeConfig",
        "lambda:GetFunctionEventInvokeConfig",
        "lambda:DeleteFunctionEventInvokeConfig"
      ],
      "Resource": "arn:aws:lambda:eu-west-1:567158658992:function:findly-pr-72-selfie-indexer"
    },
    {
      "Sid": "Pr72SchedulerExecutionRole",
      "Effect": "Allow",
      "Action": ["iam:PassRole"],
      "Resource": "arn:aws:iam::567158658992:role/findly-pr-72-retention-purger-scheduler-role",
      "Condition": {
        "StringEquals": {
          "iam:PassedToService": "scheduler.amazonaws.com"
        }
      }
    },
    {
      "Sid": "Pr72AlertSubscriptionLifecycle",
      "Effect": "Allow",
      "Action": [
        "sns:GetSubscriptionAttributes",
        "sns:SetSubscriptionAttributes",
        "sns:Unsubscribe"
      ],
      "Resource": "arn:aws:sns:eu-west-1:567158658992:findly-pr-72-alerts"
    },
    {
      "Sid": "Pr72DlqAlarm",
      "Effect": "Allow",
      "Action": [
        "cloudwatch:PutMetricAlarm",
        "cloudwatch:DescribeAlarms",
        "cloudwatch:DeleteAlarms",
        "cloudwatch:TagResource",
        "cloudwatch:UntagResource",
        "cloudwatch:ListTagsForResource"
      ],
      "Resource": "arn:aws:cloudwatch:eu-west-1:567158658992:alarm:findly-pr-72-photos-dlq-has-messages"
    },
    {
      "Sid": "Pr72BucketNotifications",
      "Effect": "Allow",
      "Action": ["s3:PutBucketNotification"],
      "Resource": "arn:aws:s3:::findly-pr-72-567158658992-eu-west-1"
    },
    {
      "Sid": "Pr72CreatePhotoQueueMapping",
      "Effect": "Allow",
      "Action": ["lambda:CreateEventSourceMapping"],
      "Resource": "*",
      "Condition": {
        "ArnEquals": {
          "lambda:FunctionArn": "arn:aws:lambda:eu-west-1:567158658992:function:findly-pr-72-photo-matcher"
        },
        "StringEquals": {
          "aws:RequestedRegion": "eu-west-1",
          "aws:RequestTag/Project": "findly",
          "aws:RequestTag/Ephemeral": "true",
          "aws:RequestTag/PullRequest": "72"
        }
      }
    },
    {
      "Sid": "Pr72PhotoQueueMappingLifecycle",
      "Effect": "Allow",
      "Action": [
        "lambda:GetEventSourceMapping",
        "lambda:UpdateEventSourceMapping",
        "lambda:DeleteEventSourceMapping"
      ],
      "Resource": "arn:aws:lambda:eu-west-1:567158658992:event-source-mapping:*",
      "Condition": {
        "ArnEquals": {
          "lambda:FunctionArn": "arn:aws:lambda:eu-west-1:567158658992:function:findly-pr-72-photo-matcher"
        }
      }
    },
    {
      "Sid": "Pr72PhotoQueueMappingTags",
      "Effect": "Allow",
      "Action": [
        "lambda:ListTags",
        "lambda:TagResource",
        "lambda:UntagResource"
      ],
      "Resource": "arn:aws:lambda:eu-west-1:567158658992:event-source-mapping:*",
      "Condition": {
        "StringEquals": {
          "aws:ResourceTag/Project": "findly",
          "aws:ResourceTag/Ephemeral": "true",
          "aws:ResourceTag/PullRequest": "72"
        }
      }
    },
    {
      "Sid": "Pr72SyntheticDataAssertions",
      "Effect": "Allow",
      "Action": ["dynamodb:GetItem", "dynamodb:DeleteItem", "dynamodb:Query"],
      "Resource": [
        "arn:aws:dynamodb:eu-west-1:567158658992:table/findly-pr-72",
        "arn:aws:dynamodb:eu-west-1:567158658992:table/findly-pr-72/index/GSI2"
      ]
    },
    {
      "Sid": "Pr72InvokeRetentionAcceptance",
      "Effect": "Allow",
      "Action": ["lambda:InvokeFunction"],
      "Resource": "arn:aws:lambda:eu-west-1:567158658992:function:findly-pr-72-retention-purger"
    },
    {
      "Sid": "Pr72SyntheticSelfieFixtures",
      "Effect": "Allow",
      "Action": ["s3:PutObject"],
      "Resource": "arn:aws:s3:::findly-pr-72-567158658992-eu-west-1/events/*/selfies/*"
    },
    {
      "Sid": "Pr72FaceAssertionAndCleanup",
      "Effect": "Allow",
      "Action": ["rekognition:ListFaces", "rekognition:DeleteCollection"],
      "Resource": "arn:aws:rekognition:eu-west-1:567158658992:collection/findly-pr-72-event-*"
    },
    {
      "Sid": "Pr72PoisonQueueMessage",
      "Effect": "Allow",
      "Action": ["sqs:SendMessage"],
      "Resource": "arn:aws:sqs:eu-west-1:567158658992:findly-pr-72-photos-queue"
    },
    {
      "Sid": "Pr72DlqAndAlarmAssertions",
      "Effect": "Allow",
      "Action": [
        "sqs:ReceiveMessage",
        "sqs:DeleteMessage",
        "sqs:ChangeMessageVisibility"
      ],
      "Resource": [
        "arn:aws:sqs:eu-west-1:567158658992:findly-pr-72-photos-dlq",
        "arn:aws:sqs:eu-west-1:567158658992:findly-pr-72-alert-probe"
      ]
    },
    {
      "Sid": "Pr72ApplicationLogAssertions",
      "Effect": "Allow",
      "Action": ["logs:FilterLogEvents"],
      "Resource": [
        "arn:aws:logs:eu-west-1:567158658992:log-group:/aws/lambda/findly-pr-72-*",
        "arn:aws:logs:eu-west-1:567158658992:log-group:/aws/lambda/findly-pr-72-*:*"
      ]
    },
    {
      "Sid": "ReadDeletedMappingForTerraformWaiter",
      "Effect": "Allow",
      "Action": "lambda:GetEventSourceMapping",
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "eu-west-1"
        }
      }
    }
  ]
}
